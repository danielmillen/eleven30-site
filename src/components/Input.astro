---
interface Props {
  label?: string;
  name: string;
  type?: string;
  required?: boolean;
  placeholder?: string;
  hint?: string;
  error?: string;
  maxlength?: number;
}

const { label, name, type = 'text', required = false, placeholder, hint, error, maxlength } = Astro.props;

const message = error ?? hint;
---

<div class="flex flex-col gap-2">
  {label && (
    <label for={name} class="text-label font-medium text-fg">
      {label}
    </label>
  )}
  <input
    id={name}
    class="e30-field w-full"
    name={name}
    type={type as any}
    required={required}
    placeholder={placeholder}
    maxlength={maxlength}
    aria-invalid={error ? 'true' : undefined}
  />
  {message && <p class={`text-caption ${error ? 'text-fg-critical' : 'text-fg-subtle'}`}>{message}</p>}
</div>
