---
import Card from './Card.astro';
import Badge from './Badge.astro';
import Icon from './Icon.astro';
import { STATUS_META, PLATFORM_LABELS, type AppEntry } from '../lib/collections';

interface Props {
  app: AppEntry;
  layout: 'grid' | 'row';
}

const { app, layout } = Astro.props;

const status = STATUS_META[app.data.status];
const platformText = app.data.platforms.map((platform) => PLATFORM_LABELS[platform]).join(' · ');
const href = `/apps/${app.id}/`;
---

{
  layout === 'grid' ? (
    <Card interactive padding="lg" href={href}>
      <div class="flex items-start justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="e30-shot flex shrink-0 items-center justify-center" style="width: 46px; height: 46px; border-radius: 11px">
            <Icon name={app.data.icon} size={20} class="text-icon-muted" />
          </div>
          <span class="text-title font-display font-semibold">{app.data.name}</span>
        </div>
        <Badge tone={status.tone}>{status.label}</Badge>
      </div>
      <p class="max-w-[44ch] text-fg-muted">{app.data.tagline}</p>
      <div class="mt-auto flex items-center gap-3 font-data text-caption text-fg-subtle">
        <span>{platformText}</span>
      </div>
    </Card>
  ) : (
    <Card interactive padding="lg" href={href}>
      <div class="relative">
        <div class="flex flex-wrap items-center pr-8" style="gap: 20px 28px">
          <div
            class="e30-shot flex shrink-0 items-center justify-center"
            style="width: 72px; height: 72px; border-radius: 18px; flex: 0 0 auto"
          >
            <Icon name={app.data.icon} size={24} class="text-icon-muted" />
          </div>
          <div style="flex: 1 1 260px">
            <div class="flex flex-wrap items-center gap-3">
              <span class="text-title font-display font-semibold">{app.data.name}</span>
              <Badge tone={status.tone}>{status.label}</Badge>
            </div>
            <p class="mt-2 max-w-[60ch] text-fg-muted">{app.data.tagline}</p>
            <div class="mt-3.5 flex items-center gap-3 font-data text-caption text-fg-subtle">
              <span>{platformText}</span>
            </div>
          </div>
        </div>
        <span class="absolute top-0 right-0">
          <Icon name="chevron-right" size={20} class="text-icon-muted" />
        </span>
      </div>
    </Card>
  )
}
