---
interface Props {
  label?: string;
  name: string;
  required?: boolean;
  placeholder?: string;
  hint?: string;
  error?: string;
  maxlength?: number;
}

const { label, name, required = false, placeholder, hint, error, maxlength } = Astro.props;

const message = error ?? hint;
---

<div class="flex flex-col gap-2">
  {label && (
    <label for={name} class="text-label font-medium text-fg">
      {label}
    </label>
  )}
  <textarea
    id={name}
    class="e30-field w-full min-h-[140px] py-3"
    name={name}
    required={required}
    placeholder={placeholder}
    maxlength={maxlength}
    aria-invalid={error ? 'true' : undefined}
  ></textarea>
  {message && <p class={`text-caption ${error ? 'text-fg-critical' : 'text-fg-subtle'}`}>{message}</p>}
</div>
