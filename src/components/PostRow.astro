---
import type { CollectionEntry } from 'astro:content';
import { readingTime, formatDate } from '../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  dense?: boolean;
}

const { post, dense = false } = Astro.props;

const href = `/blog/${post.id}/`;
const date = formatDate(post.data.pubDate);
const tag = post.data.tags[0];
---

{
  dense ? (
    <a
      href={href}
      class="flex flex-wrap items-baseline border-b border-hairline px-2 py-[22px] text-fg hover:bg-ink-050"
      style="gap: 6px 20px"
    >
      <span class="font-data text-caption text-fg-subtle" style="flex: 0 0 auto; min-width: 98px">{date}</span>
      <span style="flex: 1 1 260px">
        <span class="block text-headline font-medium">{post.data.title}</span>
        <span class="mt-1.5 block max-w-[58ch] text-fg-muted">{post.data.description}</span>
      </span>
    </a>
  ) : (
    <a
      href={href}
      class="flex flex-wrap items-baseline border-b border-hairline px-2 py-[26px] text-fg hover:bg-ink-050"
      style="gap: 8px 24px"
    >
      <span class="flex flex-col gap-2" style="flex: 0 0 auto; min-width: 130px">
        <span class="font-data text-caption text-fg-subtle">{date}</span>
        {tag && <span class="font-data text-micro uppercase tracking-[var(--ls-micro)] text-fg-accent">{tag}</span>}
      </span>
      <span style="flex: 1 1 280px">
        <span class="block text-title font-medium">{post.data.title}</span>
        <span class="mt-2 block max-w-[62ch] text-fg-muted">{post.data.description}</span>
        <span class="mt-3 block font-data text-caption text-fg-subtle">{readingTime(post.body ?? '')}</span>
      </span>
    </a>
  )
}
