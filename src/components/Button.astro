---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost' | 'critical';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  fullWidth?: boolean;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  fullWidth = false,
  type = 'button',
  disabled = false,
} = Astro.props;

const classes = `e30-btn e30-btn--${size} e30-btn--${variant}${fullWidth ? ' w-full' : ''}`;
---

{
  href && disabled ? (
    // Anchors can't be natively disabled — a disabled-looking `<a href>`
    // would still be fully clickable/focusable, so fall back to a `<span>`
    // instead of rendering a real link.
    <span class={classes} aria-disabled="true">
      <slot />
    </span>
  ) : href ? (
    <a class={classes} href={href}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} disabled={disabled}>
      <slot />
    </button>
  )
}
