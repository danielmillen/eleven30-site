---
interface Props {
  size?: number;
}

const { size = 28 } = Astro.props;

const radius = 0.24 * size;
const fontSize = 0.62 * size;
---

<span
  class="e30-monogram inline-flex items-center justify-center bg-accent text-fg-on-accent font-display"
  style={`width: ${size}px; height: ${size}px; border-radius: ${radius}px; font-size: ${fontSize}px; font-weight: 800; letter-spacing: -0.03em;`}
>
  30
</span>
