---
interface Props {
  label: string; // default slot is the row body
}

const { label } = Astro.props;
---

<div class="grid gap-6 items-baseline" style="grid-template-columns: 150px minmax(0,1fr)">
  <span class="font-data text-micro uppercase tracking-[var(--ls-micro)] text-fg-accent">{label}</span>
  <span><slot /></span>
</div>
