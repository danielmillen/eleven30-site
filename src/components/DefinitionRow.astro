---
interface Props {
  label: string; // default slot is the row body
}

const { label } = Astro.props;
---

<div class="flex flex-wrap items-baseline" style="gap: 8px 24px">
  <span
    class="font-data text-micro uppercase tracking-[var(--ls-micro)] text-fg-accent"
    style="flex: 0 0 auto; min-width: 126px"
  >
    {label}
  </span>
  <span style="flex: 1 1 280px"><slot /></span>
</div>
