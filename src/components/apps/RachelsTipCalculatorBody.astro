---
import Section from '../Section.astro';
import Card from '../Card.astro';
import Icon from '../Icon.astro';
import type { AppEntry } from '../../lib/collections';

interface Props {
  app: AppEntry;
}

/**
 * Page-specific marketing copy, not shared static data (unlike
 * src/data/principles.ts etc.) — this content only ever appears on this one
 * app's landing page, so it lives inline here rather than in src/data/.
 */
const tipFeatures = [
  {
    icon: 'pencil',
    title: 'Line by line',
    body: 'The exact figures to write on the tip line and the total line. No mental arithmetic at the table.',
  },
  {
    icon: 'arrows-up-down',
    title: 'Round the total',
    body: 'Nudge the total up or down to a clean number and it back-solves the tip for you.',
  },
  {
    icon: 'users-group',
    title: 'Split the check',
    body: 'Divide by however many people, including the tip, with the remainder handled sensibly.',
  },
  {
    icon: 'lock',
    title: 'Almost nothing leaves the phone',
    body: 'No account, no receipts stored anywhere — the one exception is your advertiser ID, and only if you allow it.',
  },
];

// `app` is unused here — this body's copy is fixed marketing content, not
// derived from the content-collection entry. The prop exists so every
// registered `APP_BODIES` component shares one call signature (`{ app }`).
---

<Section tone="sunken">
  <div
    class="grid items-center"
    style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr)); gap: clamp(32px, 5vw, 56px);"
  >
    <div>
      <h2 class="m-0 font-display text-display-md font-semibold tracking-[var(--ls-display-md)]">
        Built for Rachel
      </h2>
      <p class="mt-5 text-body-lg text-fg-muted">
        This one started as an audience of one. My wife, Rachel, used to juggle two or three tip apps at the
        table, one of which ran a full-screen ad on launch and made her wait before she could even start. I
        figured I could do better than that for her, so I did. If it's useful to you too, that's a bonus.
      </p>
    </div>
    <div class="grid gap-4" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr))">
      {
        tipFeatures.map((feature) => (
          <Card padding="md">
            <Icon name={feature.icon} size={20} class="text-icon-accent" />
            <div class="font-medium">{feature.title}</div>
            <p class="m-0 text-label leading-normal text-fg-muted">{feature.body}</p>
          </Card>
        ))
      }
    </div>
  </div>
</Section>
