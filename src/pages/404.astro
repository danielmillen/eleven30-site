---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page not found — Eleven30" description="This page doesn't exist." path="/404/">
  <Section width="reading" pad="pt-[72px] pb-[88px]">
    <div class="mb-4 font-data text-micro uppercase tracking-[var(--ls-micro)] text-fg-subtle">404</div>
    <h1 class="m-0 font-display text-display-lg font-semibold">Page not found.</h1>
    <p class="mt-5 max-w-[56ch] text-body-lg text-fg-muted">
      The page you're looking for doesn't exist or has moved.
    </p>
    <div class="mt-8">
      <Button href="/">Back home</Button>
    </div>
  </Section>
</BaseLayout>
