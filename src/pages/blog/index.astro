---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { getPublishedPosts } from '../../lib/blog';

const posts = await getPublishedPosts();
---

<BaseLayout
  title="Blog — Eleven30"
  description="Design decisions, the occasional teardown, and what I got wrong last month."
  path="/blog/"
>
  <section class="bg-paper py-20">
    <div class="mx-auto max-w-[900px] px-[clamp(20px,4vw,32px)]">
      <div class="mb-4 font-data text-micro uppercase tracking-[var(--ls-micro)] text-fg-subtle">
        Blog
      </div>
      <h1
        class="m-0 font-display font-semibold"
        style="font-size: clamp(30px, 5.6vw, var(--text-display-lg)); line-height: 1.08; letter-spacing: var(--ls-display-lg);"
      >
        Notes on building it.
      </h1>
      <p class="mt-5 max-w-[58ch] text-body-lg text-fg-muted">
        Design decisions, the occasional teardown, and what I got wrong last month.
      </p>
      <div class="mt-11 flex flex-col border-t border-hairline">
        {posts.map((post) => <PostRow post={post} />)}
      </div>
    </div>
  </section>
</BaseLayout>
