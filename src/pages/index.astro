---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import PlaceholderMedia from '../components/PlaceholderMedia.astro';
import Icon from '../components/Icon.astro';
import AppCard from '../components/AppCard.astro';
import PostRow from '../components/PostRow.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import { getApps } from '../lib/collections';
import { getPublishedPosts } from '../lib/blog';
import { nowItems } from '../data/now';
import { SITE } from '../config/site';

const apps = await getApps();
const recentPosts = (await getPublishedPosts()).slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
};
---

<BaseLayout title="Eleven30" description={SITE.description} path="/" jsonLd={jsonLd}>
  <Section pad="pt-24 pb-21">
    <div class="grid items-center gap-16" style="grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr)">
      <div>
        <div class="mb-5 font-data text-micro uppercase tracking-[var(--ls-micro)] text-fg-subtle">
          {SITE.tagline}
        </div>
        <h1
          class="m-0 font-display font-semibold text-balance"
          style="font-size: clamp(40px, 5.2vw, 66px); line-height: 1.04; letter-spacing: -0.035em"
        >
          Small apps, built by one person, finished properly.
        </h1>
        <p class="mt-6 max-w-[52ch] text-body-lg text-fg-muted">
          I'm a solo developer with 25 years in software. Eleven30 is where I build the things I
          wanted to exist — a launch countdown for your own patch of sky, and a tip calculator that
          tells you exactly what to write on the receipt.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button size="lg" href="/apps/">See the apps</Button>
          <Button size="lg" variant="secondary" href="/about/">About me</Button>
        </div>
      </div>
      <PlaceholderMedia
        icon="rocket"
        caption="Countdown screen"
        dimensions="1290 × 2796"
        aspect="9 / 17"
        radius="30px"
      />
    </div>
  </Section>

  <Section tone="sunken">
    <div class="mb-8 flex items-baseline justify-between gap-6">
      <h2 class="m-0 font-display text-display-md font-semibold">The apps</h2>
      <a href="/apps/" class="text-body text-fg-accent">All apps →</a>
    </div>
    <div class="grid gap-5" style="grid-template-columns: repeat(auto-fit, minmax(320px, 1fr))">
      {apps.map((app) => <AppCard app={app} layout="grid" />)}
    </div>
  </Section>

  <Section>
    <div class="grid gap-14" style="grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr)">
      <div>
        <div class="mb-2 flex items-baseline justify-between gap-6">
          <h2 class="m-0 font-display text-display-md font-semibold">Recent writing</h2>
          <a href="/blog/" class="text-body text-fg-accent">All posts →</a>
        </div>
        <div class="flex flex-col">
          {recentPosts.map((post) => <PostRow post={post} dense />)}
        </div>
      </div>
      <div class="flex flex-col gap-4">
        <Card padding="lg">
          <div class="font-data text-micro uppercase tracking-[var(--ls-micro)] text-fg-subtle">Now</div>
          <div class="flex flex-col gap-3">
            {
              nowItems.map((item) => (
                <div class="flex items-start gap-3">
                  <Icon name={item.icon} size={16} class="mt-0.5 shrink-0 text-icon-accent" />
                  <span class="text-fg-muted">{item.text}</span>
                </div>
              ))
            }
          </div>
          <a href="/now/" class="mt-auto self-start text-label text-fg-accent">The full now page →</a>
        </Card>
        <Card tone="accent" padding="lg">
          <div class="font-data text-micro uppercase tracking-[var(--ls-micro)] text-fg-accent">
            Consulting
          </div>
          <p class="m-0 text-fg-muted">
            I take one client project at a time — product design and build for teams who need a
            senior pair of hands, not a headcount.
          </p>
          <div class="self-start">
            <Button variant="secondary" href="/consulting/">How I work with teams</Button>
          </div>
        </Card>
      </div>
    </div>
  </Section>

  <Section tone="deep" pad="py-22">
    <div class="grid items-center gap-16" style="grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr)">
      <div>
        <div class="mb-[18px] font-data text-micro uppercase tracking-[var(--ls-micro)] opacity-65">
          About
        </div>
        <p class="m-0 font-editorial text-[32px] leading-[1.3] tracking-[-0.01em]">
          Twenty-five years of shipping other people's roadmaps taught me what I actually wanted to
          build: small, finished software that respects the person holding the phone.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button variant="secondary" href="/about/">More about me</Button>
          <Button variant="ghost" href="/contact/">Get in touch</Button>
        </div>
      </div>
      <PlaceholderMedia
        icon="camera"
        caption="Photo — desk / workspace"
        dimensions="1600 × 1200"
        aspect="4 / 3"
        onDark
      />
    </div>
  </Section>
</BaseLayout>
