---
import PolicyLayout from '../../../layouts/PolicyLayout.astro';
import {
  getApps,
  getPolicyForApp,
  assertPolicyCoverage,
  type AppEntry,
  type PolicyEntry,
} from '../../../lib/collections';

export async function getStaticPaths() {
  // Deliberately redundant with the call in src/pages/apps/index.astro: the
  // orphan-policy half of the invariant should be guaranteed by two
  // independent, always-built routes, not droppable from a single call site.
  await assertPolicyCoverage();
  const apps = await getApps();
  return Promise.all(
    apps.map(async (app) => ({
      params: { app: app.id },
      props: { app, policy: await getPolicyForApp(app) },
    }))
  );
}

interface Props {
  app: AppEntry;
  policy: PolicyEntry;
}

const { app, policy } = Astro.props;
---

<PolicyLayout policy={policy} app={app} />
